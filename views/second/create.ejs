<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create | Stories Time</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Local CSS -->
    <link rel="stylesheet" href="/css/second/create.css">
</head>
<body>
    <div class="hero">
        <!-- Navbar -->
        <div class="nav">
            <nav class="navbar navbar-expand-lg">
                <a class="navbar-brand" href="/home">Stories Time</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                  <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <div class="navbar-nav">
                        <a class="nav-item nav-link" href="/home">HOME</a>
                        <a class="nav-item nav-link active" href="/home/create">CREATE</a>
                        <a class="nav-item nav-link" href="/home/portfolio">PORTFOLIO</a>
                        <a class="nav-item nav-link" href="/logout">LOGOUT</a>
                    </div>
                </div>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="main">
            <div class="left">
                <h2>Create a Story</h2>
                <!-- Form starts -->
                <form action="/home/create" method="POST">
                    <div class="form-group mb-3">
                      <label>Name of Story</label>
                      <input type="text" class="form-control" placeholder="Enter name of the story" name="title" required>
                    </div>
                    <div class="form-group mb-3">
                      <label>About</label>
                      <input type="text" class="form-control" placeholder="Write a few lines about the story" name="about" required>
                    </div>
                    <div class="form-group mb-4">
                        <label>Story Description</label>
                        <textarea class="form-control" rows="5" name="description" required></textarea>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="bttn btn btn-success">Upload</button>
                    </div>
                </form>
                <!-- Form ends -->
            </div>
            <div class="right">
                <img src="/img/create-img.jpg" alt="Create Story" class="img img-fluid">
            </div>
        </div>
    </div>

    <footer class="text-center mt-5">
        <p>Copyright &copy; Varun Kumar</p>
    </footer>
</body>
</html>
