<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | StoriesTime</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Local CSS -->
    <link rel="stylesheet" href="/css/second/portfolio.css">
</head>
<body>  
    <div class="hero">
        <!-- Navbar -->
        <div class="nav">
            <nav class="navbar navbar-expand-lg">
                <a class="navbar-brand" href="/home">STORIES TIME</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                    <div class="navbar-nav">
                        <a class="nav-item nav-link" href="/home">HOME</a>
                        <a class="nav-item nav-link" href="/home/create">CREATE</a>
                        <a class="nav-item nav-link active" href="/home/portfolio">PORTFOLIO</a>
                        <a class="nav-item nav-link" href="/">LOGOUT</a>
                    </div>
                </div>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="main container mt-4">
            <div class="main-heading text-center mb-4">
                <% if(user.id == curr_user.id){ %>
                    <h2 class="recent_H"> Hello <span class="text-uppercase px-2"><%= user.name %></span>, your uploaded stories are:</h2>
                <% } else { %>
                    <h2 class="recent_H"> Uploaded Stories of <span class="text-uppercase px-2"><%= user.name %></span>:</h2>
                <% } %>
            </div>

            <% if(user.Posts.length > 0) { %> 
                <% user.Posts.forEach(story => { %> 
                    <div class="post-row d-flex justify-content-center mb-4">
                        <div class="col-md-8">
                            <div class="row g-0 border rounded overflow-hidden flex-md-row shadow-sm h-md-250 position-relative">
                                <div class="col p-4 d-flex flex-column position-static">
                                    <h3 class="mb-0" id="heading"><%= story.title %></h3>
                                    <div class="mb-2 text-muted" id="date"><%= story.createdAt.toDateString() %></div>
                                    <p class="card-text mb-auto" id="about"><%= story.about %></p>
                                    <a href="/home/storyDetail/<%= story._id %>" class="stretched-link">Continue reading</a>
                                </div>
                                <div class="col-auto d-none d-lg-block">
                                    <img class="bd-placeholder-img" width="300" height="250" src="/img/cute-girl.jpg" alt="Story Thumbnail">
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty text-center mt-5">
                    <p>You haven't posted anything yet.</p>
                    <a href="/home/create" class="btn btn-primary">Let's Go</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center mt-5">
        <p>&copy; Varun Kumar</p>
    </footer>
</body>
</html>
